# ========================================
# CONFIGURATION ENVIRONNEMENT - EXEMPLE
# ========================================

# Environnement
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ========================================
# BASE DE DONNÉES POSTGRESQL
# ========================================

# URL complète (recommandé)
DATABASE_URL=postgresql://saas_user:saas_password@localhost:5432/saas_app

# OU configuration séparée
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=saas_app
# DB_USER=saas_user
# DB_PASSWORD=saas_password
# DB_MAX_CONNECTIONS=20
# DB_IDLE_TIMEOUT=30000
# DB_CONNECTION_TIMEOUT=2000

# ========================================
# REDIS CACHE
# ========================================

# URL complète (recommandé)
# REDIS_URL=redis://username:password@localhost:6379/0

# OU configuration séparée
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# ========================================
# AUTHENTIFICATION JWT
# ========================================

# Secrets JWT (CHANGEZ EN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# SÉCURITÉ
# ========================================

# Hashage des mots de passe
BCRYPT_ROUNDS=12

# Protection contre les attaques par force brute
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_TIME=1800000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WHITELIST=127.0.0.1,::1

# ========================================
# CORS
# ========================================

CORS_ORIGIN=http://localhost:3000

# ========================================
# LOGS
# ========================================

LOG_LEVEL=debug
LOG_DIR=./logs
# LOG_FILE=./logs/app.log

# ========================================
# AUTHENTIFICATION 2FA
# ========================================

TOTP_SERVICE_NAME=SaaS App
TOTP_ISSUER=Your Company

# ========================================
# EMAIL (À CONFIGURER)
# ========================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@your-domain.com

# ========================================
# SMS (À CONFIGURER)
# ========================================

# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# STOCKAGE FICHIERS (À CONFIGURER)
# ========================================

# AWS S3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=eu-west-1
# AWS_S3_BUCKET=your-bucket-name

# OU Local storage
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=10485760

# ========================================
# MONITORING (OPTIONNEL)
# ========================================

# Sentry pour le monitoring des erreurs
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# New Relic pour les performances
# NEW_RELIC_LICENSE_KEY=your-license-key
# NEW_RELIC_APP_NAME=SaaS App Backend

# ========================================
# DÉVELOPPEMENT UNIQUEMENT
# ========================================

# Désactiver certaines vérifications en dev
# DISABLE_AUTH=false
# DISABLE_RATE_LIMIT=false
# MOCK_EMAIL=true
# MOCK_SMS=true

