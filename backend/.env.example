# Configuration de la base de données
DATABASE_URL=postgresql://saas_user:saas_password@localhost:5432/saas_app

# Configuration Redis
REDIS_URL=redis://localhost:6379

# Configuration JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Configuration Email (pour 2FA et récupération de mot de passe)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourcompany.com

# Configuration 2FA
TOTP_SERVICE_NAME=SaaS App
TOTP_ISSUER=Your Company

# Configuration Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuration serveur
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Configuration CORS
CORS_ORIGIN=http://localhost:3000

# Configuration de sécurité
BCRYPT_ROUNDS=12
PASSWORD_RESET_EXPIRES=3600000
ACCOUNT_LOCKOUT_TIME=1800000
MAX_LOGIN_ATTEMPTS=5

# Configuration des uploads
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Configuration des logs
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Configuration Bull Queue
QUEUE_REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=5

# Configuration de développement
DEBUG=saas:*

