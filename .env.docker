# ========================================
# Docker Environment Configuration
# Multi-Tenant SaaS Application
# ========================================

# Application
NODE_ENV=production
APP_NAME=Multi-Tenant SaaS
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=3001
HTTP_PORT=80
HTTPS_PORT=443

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=saas_app
DB_USER=saas_user
DB_PASSWORD=saas_password_change_in_production

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_change_in_production

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# NextAuth (for frontend)
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production-min-32-chars
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Multi-Tenant SaaS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@saas-app.com

# Logging
LOG_LEVEL=info

# Monitoring Tools (Optional)
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin_change_in_production

PGADMIN_PORT=8080
PGADMIN_EMAIL=admin@saas-app.com
PGADMIN_PASSWORD=admin_change_in_production

# SSL (for production)
SSL_CERT_PATH=./docker/nginx/ssl/cert.pem
SSL_KEY_PATH=./docker/nginx/ssl/key.pem

