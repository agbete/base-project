# Configuration de l'API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Configuration de l'application
NEXT_PUBLIC_APP_NAME=SaaS App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0

# Configuration de l'environnement
NODE_ENV=development

# Configuration de sécurité
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production

# Configuration PWA
NEXT_PUBLIC_PWA_ENABLED=true

# Configuration des uploads
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Configuration de l'analytics (optionnel)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Configuration de debug
DEBUG=false
NEXT_PUBLIC_DEBUG=false

# Configuration des fonctionnalités
NEXT_PUBLIC_ENABLE_2FA=true
NEXT_PUBLIC_ENABLE_OFFLINE=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# Configuration de l'internationalisation
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_SUPPORTED_LOCALES=fr,en

# Configuration du thème
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_ENABLE_THEME_SWITCHER=true

# Configuration de la mise en cache
NEXT_PUBLIC_CACHE_ENABLED=true
NEXT_PUBLIC_CACHE_TTL=300000

# Configuration des notifications push (optionnel)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

